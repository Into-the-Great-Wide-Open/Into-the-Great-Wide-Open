---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countCountriesPerTrip, getTripHeroPhoto } from '../../lib/tripStats';
import { tryResolveImage } from '../../lib/images';

// USA isn't a single trip of its own — it still gets a full dedicated hub
// page (src/pages/trips/usa.astro, regions/lyric/map intact), but it no
// longer gets a card here. It's linked from the Other Travels page instead.
// See design-brief.md "USA hub page".
//
// Display order: the two big trips (Into the Great Wide Open, Southward
// Bound) lead, side by side, followed by everything else in whatever order
// getCollection returns them (alphabetical by filename).
const DISPLAY_ORDER = ['into-the-great-wide-open', 'southward-bound'];

const trips = (await getCollection('trips')).filter((trip) => trip.data.slug !== 'usa');
const entries = await getCollection('entries');
const countryCounts = countCountriesPerTrip(entries);
const sortedTrips = [...trips].sort((a, b) => {
  const ai = DISPLAY_ORDER.indexOf(a.data.slug);
  const bi = DISPLAY_ORDER.indexOf(b.data.slug);
  if (ai === -1 && bi === -1) return 0; // keep relative order for everything else
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});
const tripCards = sortedTrips.map((trip) => ({
  trip,
  countryCount: countryCounts.get(trip.data.slug) ?? 0,
  heroImg: tryResolveImage(getTripHeroPhoto(trip.data.slug, entries)),
}));
---

<BaseLayout title="Trips">
  <div class="container">
    <h1>Trips</h1>
    <div class="grid photo-cards">
      {tripCards.map(({ trip, countryCount, heroImg }) => (
        <a class="photo-card" href={`/trips/${trip.data.slug}`}>
          {heroImg && (
            <div class="photo-card-image">
              <Image src={heroImg} alt="" loading="lazy" width={600} height={450} fit="cover" widths={[300, 600]} sizes="(max-width: 600px) 50vw, 300px" />
            </div>
          )}
          <div class="photo-card-body">
            <h3>{trip.data.name}</h3>
            <p class="meta">
              {trip.data.cityCount} stops · {countryCount} {countryCount === 1 ? 'country' : 'countries'}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
