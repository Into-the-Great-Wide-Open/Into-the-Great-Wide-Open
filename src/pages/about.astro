---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import karakulImg from '../assets/images/about/karakul.jpg';
import kashgarImg from '../assets/images/about/kashgar.jpg';
import beijingImg from '../assets/images/about/beijing.jpg';
import gibraltarImg from '../assets/images/about/gibraltar.jpg';

const photos = [
  { src: karakulImg, caption: 'Karakul, China', href: '/entries/asia-china-karakul' },
  { src: kashgarImg, caption: 'Kashgar, China', href: '/entries/asia-china-kashgar' },
  { src: beijingImg, caption: 'Beijing, China', href: '/entries/asia-china-beijing' },
  { src: gibraltarImg, caption: 'Gibraltar', href: '/entries/europe-gibraltar-gibraltar' },
];

const aboutPage = await getEntry('aboutPage', 'about');
if (!aboutPage) {
  throw new Error("Missing content entry 'about' in the 'aboutPage' collection (src/content/about-page/about.md)");
}
const { Content } = await render(aboutPage);
---

<BaseLayout
  title="About"
  description="About Andrew and Into the Great Wide Open."
>
  <div class="container" data-pagefind-body>
    <span hidden data-pagefind-meta="place:About"></span>
    <div class="about-grid">
      {photos.map((photo) => (
        <a class="about-grid-item" href={photo.href}>
          <Image src={photo.src} alt={photo.caption} loading="lazy" width={440} height={293} fit="cover" widths={[220, 440]} sizes="(max-width: 600px) 50vw, 220px" />
          <span class="about-grid-caption">{photo.caption}</span>
        </a>
      ))}
    </div>

    {aboutPage.data.lyric && (
      <div class="lyric">
        {aboutPage.data.lyric.lines.map((line) => <p>{line}</p>)}
        {aboutPage.data.lyric.attribution && (
          <cite>
            {aboutPage.data.lyric.attributionHref ? (
              <a href={aboutPage.data.lyric.attributionHref} target="_blank" rel="noopener">{aboutPage.data.lyric.attribution}</a>
            ) : aboutPage.data.lyric.attribution}
          </cite>
        )}
      </div>
    )}

    <h1>About</h1>

    <div class="prose">
      <Content />
    </div>

    <p>
      <a class="tag" href="mailto:Andrew@intothegreatwideopen.com">Get in touch</a>
    </p>
  </div>
</BaseLayout>
