---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!--
  Site search (see design-brief.md's "Site search" section for the confirmed
  spec). Built on Pagefind, a static/client-side search index generated from
  the built site's own HTML — there's no server and no separate search
  service to run. The index itself (`/pagefind/pagefind.js` + its data files)
  is generated by the `pagefind` step now appended to `npm run build` (see
  package.json); it does not exist in `npm run dev` and won't until a real
  build has been run at least once, so this page's script guards for that
  and shows a plain message rather than a raw error if the index is missing.

  A full results page on submit, not an instant dropdown — per the confirmed
  spec, chosen because this site has hundreds of entries and thousands of
  photos, and a broad query benefits from room to show several results side
  by side with real snippets, more than from the speed of a dropdown.
-->
<BaseLayout title="Search" description="Search Into the Great Wide Open.">
  <div class="container">
    <h1>Search</h1>

    <form id="search-form" class="search-form" role="search">
      <input
        type="search"
        name="q"
        id="search-input"
        class="search-input"
        placeholder="Search places, stories, captions…"
        autocomplete="off"
      />
      <button type="submit" class="btn-outline">Search</button>
    </form>

    <p class="meta" id="search-status"></p>
    <div class="search-results" id="search-results"></div>
  </div>

  <script>
    let pagefindPromise: Promise<any> | null = null;

    function loadPagefind() {
      if (!pagefindPromise) {
        // @ts-ignore — generated at build time by `pagefind --site dist`
        // (see package.json's "build" script), not present in `npm run dev`.
        pagefindPromise = import(/* @vite-ignore */ '/pagefind/pagefind.js').then(async (mod) => {
          await mod.init();
          return mod;
        });
      }
      return pagefindPromise;
    }

    // Trip badges are a deliberate inclusion in every result (per the
    // confirmed spec) since trips are the primary organizing structure
    // everywhere else on the site — a result with no trip context (e.g. a
    // country or trip page itself, which has no "trip" meta of its own)
    // just omits that piece rather than showing a placeholder.
    function renderResult(record: any) {
      const meta = record.meta ?? {};
      const place = meta.place ?? record.meta?.title ?? 'Untitled page';
      const country = meta.country;
      const trip = meta.trip;
      const image = meta.image;

      const a = document.createElement('a');
      a.className = 'search-result';
      a.href = record.url;

      if (image) {
        const img = document.createElement('img');
        img.src = image;
        img.alt = '';
        img.loading = 'lazy';
        a.appendChild(img);
      }

      const body = document.createElement('div');
      body.className = 'search-result-body';

      const h3 = document.createElement('h3');
      h3.textContent = place;
      body.appendChild(h3);

      if (country || trip) {
        const metaLine = document.createElement('p');
        metaLine.className = 'meta search-result-meta';
        if (country) {
          const span = document.createElement('span');
          span.textContent = country;
          metaLine.appendChild(span);
        }
        if (trip) {
          const tag = document.createElement('span');
          tag.className = 'tag search-result-trip';
          tag.textContent = trip;
          metaLine.appendChild(tag);
        }
        body.appendChild(metaLine);
      }

      const snippet = document.createElement('p');
      snippet.className = 'search-snippet';
      // record.excerpt already carries <mark> tags around the matched
      // term(s) — Pagefind builds this from the page's own indexed text
      // (subtitle, body copy, or a photo caption, whatever matched).
      snippet.innerHTML = record.excerpt;
      body.appendChild(snippet);

      a.appendChild(body);
      return a;
    }

    async function runSearch(q: string) {
      const status = document.getElementById('search-status')!;
      const results = document.getElementById('search-results')!;
      results.replaceChildren();

      if (!q.trim()) {
        status.textContent = '';
        return;
      }

      status.textContent = 'Searching…';

      let pagefind;
      try {
        pagefind = await loadPagefind();
      } catch {
        status.textContent =
          "Search isn't available in this preview — it's built from a real production build (npm run build), not the dev server.";
        return;
      }

      const search = await pagefind.search(q);

      if (search.results.length === 0) {
        status.textContent = `No results for "${q}".`;
        return;
      }

      const records = await Promise.all(search.results.map((r: any) => r.data()));
      status.textContent = `${records.length} result${records.length === 1 ? '' : 's'} for "${q}"`;
      results.replaceChildren(...records.map(renderResult));
    }

    function currentQuery() {
      return new URLSearchParams(window.location.search).get('q') ?? '';
    }

    const input = document.getElementById('search-input') as HTMLInputElement;
    const form = document.getElementById('search-form') as HTMLFormElement;

    const initialQuery = currentQuery();
    input.value = initialQuery;
    if (initialQuery) runSearch(initialQuery);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value;
      const url = new URL(window.location.href);
      if (q) url.searchParams.set('q', q);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
      runSearch(q);
    });
  </script>
</BaseLayout>
